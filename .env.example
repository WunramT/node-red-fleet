# Values the flows read from the environment.
#
# Copy to .env (gitignored) and fill in the ones the instance you are
# editing needs. compose/editor.yml passes that file to the local editor,
# so a field set to "env" resolves the way it does on the host. A name
# left empty here behaves like a missing variable in a compose service:
# the node connects with no password and says nothing.
#
# NEVER commit values. In the estate these come from Jenkins credentials
# and the host's compose service; .env is for your own machine only.
#
# Regenerate this list from the flows:
#   grep -l 'FieldType": "env"' apps/*/flows.json

# gor-prod
DPN_SVR_AKFK_POSTGRES=

# dpn-prod
DPN_SVR_IOT_POSTGRES=

# dpn-prod
DPN_SVR_POSTGRES_IOT_ADMIN=

# jan-test, srem-prod, srem-test, wag-test
DPN_SVR_POSTGRES_PASSWORD_iot_user_sub=

# gor-prod
DPN_SVR_POSTGRES_TECHNIK_USER=

# gor-prod, gor-test
pg_pass=

# srem-prod, srem-test
SREM_SVR_LIN01_BACKEND_USER=

# srem-test
SREM_SVR_LIN01_POSTGRES=

# wag-test
WAG_SVR_LIN01_PASSWORD_postgres=
