// Scheduled drift sweep: what is each instance running, and is it what Git says?
//
// This job never writes to an instance. It reads, renders and publishes —
// decision 9 (drift-check is read-only) and decision 11 (the visibility layer
// is a report, not a control plane). There is no deploy parameter here on
// purpose: deploys are reviewed commits, and the Jenkinsfile beside this one is
// where they happen.
//
// The sweep runs ON EACH HOST, one call per host (decision 10). A central run
// cannot do it: drift-check reaches a runtime through Docker on the machine it
// runs on, so `--all` from anywhere else reports every instance as unreachable.
// That is why drift-check has --host.
//
// Requires the SSH Pipeline Steps and Pipeline Utility Steps plugins.

import groovy.transform.Field

@Field def REGISTRY = null
@Field def VISITED = []
@Field def RESULTS = []
@Field def NOT_SWEPT = []
// Host name -> that host's instances, plus the names in registry order. The
// two together replace groupBy(): this runs in the Groovy sandbox, where every
// GDK collection method is a separate approval an administrator has to click.
// The deploy job next door uses findAll, collect, join, any and each, and
// nothing else — so this one stays inside that vocabulary and needs no
// approval at all.
@Field def BY_HOST = [:]
@Field def HOST_NAMES = []

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '60'))
    }

    triggers {
        // Daily, early, with H so the estate is not swept by every job at once.
        // Drift is information about yesterday's edits; it does not need minutes.
        cron('H 6 * * *')
    }

    parameters {
        booleanParam(name: 'PUBLISH_TO_WORKBENCH', defaultValue: true,
            description: 'Also drop drift.json into the workbench instance that watches it (dpn-test).')
        string(name: 'WATCHER_INSTANCE', defaultValue: 'dpn-test',
            description: 'The instance whose /data receives drift.json. Its flow decides what to do with it.')
        booleanParam(name: 'PUBLISH_PAGE', defaultValue: true,
            description: 'Also copy the rendered page to a directory an nginx serves.')
        string(name: 'PAGE_HOST', defaultValue: 'dpn-svr-iot',
            description: 'Host whose nginx serves the page. Must be in the host map below.')
        string(name: 'PAGE_DIR', defaultValue: '/home/iot/Base_Container/drift',
            description: 'Directory on that host, bind-mounted into its nginx as /usr/share/nginx/html/drift.')
    }

    environment {
        REMOTE_DIR = "/tmp/dap-drift-${BUILD_NUMBER}"
    }

    stages {
        stage('Resolve') {
            steps {
                script {
                    REGISTRY = readYaml file: 'registry.yml'
                    writeJSON file: 'registry.json', json: REGISTRY, pretty: 2

                    def total = 0
                    for (inst in REGISTRY.instances) {
                        if (!inst.app) { continue }
                        if (!BY_HOST.containsKey(inst.host)) {
                            BY_HOST.put(inst.host, [])
                            HOST_NAMES << inst.host
                        }
                        BY_HOST.get(inst.host) << inst
                        total++
                    }

                    echo "Sweeping ${total} instances on ${HOST_NAMES.size()} hosts"
                    for (host in HOST_NAMES) {
                        echo "  ${host}: ${BY_HOST.get(host).collect { it.name }.join(', ')}"
                    }
                }
            }
        }

        stage('Sweep') {
            steps {
                script {
                    def mkHost = { name, ip -> [name: name, host: ip, port: 22,
                                                allowAnyHosts: true, credId: "${name}_pw"] }
                    def HOSTS = [
                        'cho-svr-lin01' : mkHost('cho-svr-lin01',  '10.11.1.101'),
                        'pod-svr-lin01' : mkHost('pod-svr-lin01',  '10.20.1.160'),
                        'jan-svr-lin01' : mkHost('jan-svr-lin01',  '10.30.1.150'),
                        'srem-svr-lin01': mkHost('srem-svr-lin01', '10.40.1.161'),
                        'wag-svr-lin01' : mkHost('wag-svr-lin01',  '10.60.1.198'),
                        'foi-svr-lnx01' : mkHost('foi-svr-lnx01',  '192.168.64.60'),
                        'gor-svr-lin01' : mkHost('gor-svr-lin01',  '10.87.1.150'),
                        'slu-svr-lin02' : mkHost('slu-svr-lin02',  '10.90.1.20'),
                        'wfm-svr-lin01' : mkHost('wfm-svr-lin01',  '10.65.1.91'),
                        'dpn-svr-iot'   : mkHost('dpn-svr-iot',    '192.168.48.240'),
                    ]

                    for (host in HOST_NAMES) {
                        def list = BY_HOST.get(host)
                        // One unreachable host must not end the sweep. The page is
                        // more useful with nine hosts and a named gap than with an
                        // aborted build and no page at all.
                        try {
                            sweepHost(HOSTS[host], host, list)
                        } catch (err) {
                            echo "!! ${host}: ${err}"
                            NOT_SWEPT << host
                            for (inst in list) {
                                RESULTS << [instance: inst.name, host: host, app: inst.app,
                                            image_tag: inst.image_tag, state: 'unreachable',
                                            detail: "host not swept: ${err}"]
                            }
                        }
                    }
                }
            }
        }

        stage('Render') {
            steps {
                script {
                    writeJSON file: 'drift.json', json: RESULTS, pretty: 2

                    def nClean = 0
                    def nDrifted = 0
                    def nUnreachable = 0
                    for (row in RESULTS) {
                        if (row.state == 'clean') { nClean++ }
                        else if (row.state == 'drifted') { nDrifted++ }
                        else if (row.state == 'unreachable') { nUnreachable++ }
                    }
                    echo "clean ${nClean}, drifted ${nDrifted}, unreachable ${nUnreachable}"

                    // Amber, not red: drift is somebody's browser edit waiting to be
                    // captured, which is information (decision 9). A host this job
                    // could not reach at all is the thing worth a colour.
                    if (NOT_SWEPT) {
                        currentBuild.result = 'UNSTABLE'
                        currentBuild.description = "not swept: ${NOT_SWEPT.join(', ')}"
                    } else if (nDrifted) {
                        currentBuild.description = "${nDrifted} drifted"
                    }

                    // Rendered on a target host, not here. The Jenkins controller
                    // has no python3 — `python3: not found` is what the first run
                    // said — and every site host does, because that is where
                    // deploy.py and drift-check.py run (decision 10). So the one
                    // machine the pipeline may not assume anything about is the one
                    // it now needs nothing from: this stage builds the JSON, and the
                    // page is made where the rest of the work already happens.
                    def remote = null
                    for (r in VISITED) { if (r.name == params.PAGE_HOST) { remote = r } }
                    if (!remote) {
                        echo "!! ${params.PAGE_HOST} was not reached in this run — no page rendered"
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        sshPut remote: remote, from: 'drift.json', into: "${REMOTE_DIR}/"
                        sshPut remote: remote, from: 'scripts/render-drift.py',
                               into: "${REMOTE_DIR}/scripts/"
                        sshCommand remote: remote, command: """
                            set -e
                            cd ${REMOTE_DIR}
                            python3 scripts/render-drift.py drift.json -o index.html
                        """
                        // Back for the archive, so a build keeps its own page even
                        // when publishing is off or the directory moves later.
                        sshGet remote: remote, from: "${REMOTE_DIR}/index.html",
                               into: 'public/index.html', override: true
                    }
                }
            }
        }

        stage('Publish the page') {
            when { expression { params.PUBLISH_PAGE } }
            steps {
                script {
                    // A loop, not find(): every GDK collection method is its own
                    // approval in the sandbox, and this job is meant to run without
                    // an administrator clicking anything.
                    def remote = null
                    for (r in VISITED) { if (r.name == params.PAGE_HOST) { remote = r } }
                    if (!remote) {
                        // Render already said so and already went amber; saying it
                        // twice in one build reads like two faults.
                        return
                    }
                    // Onto the host, not into the nginx container: a `docker cp`
                    // lives in that container's write layer and is gone the next
                    // time it is recreated. The directory is bind-mounted, so the
                    // page survives a pull, a restart and a compose up.
                    //
                    // Both files are already on this host — the page was rendered
                    // here — so this moves them into place rather than uploading them
                    // again. The raw sweep goes beside the page: whoever wants to
                    // graph it or diff two days should not have to scrape HTML.
                    sshCommand remote: remote, command: """
                        set -e
                        mkdir -p ${params.PAGE_DIR}
                        cp ${REMOTE_DIR}/index.html ${REMOTE_DIR}/drift.json ${params.PAGE_DIR}/
                        chmod 644 ${params.PAGE_DIR}/index.html ${params.PAGE_DIR}/drift.json
                    """
                    echo "page: http://${params.PAGE_HOST}/drift/"
                }
            }
        }

        stage('Publish to the watcher') {
            when { expression { params.PUBLISH_TO_WORKBENCH } }
            steps {
                script {
                    def watcher = null
                    for (i in REGISTRY.instances) { if (i.name == params.WATCHER_INSTANCE) { watcher = i } }
                    if (!watcher) {
                        error("No instance named '${params.WATCHER_INSTANCE}' in registry.yml")
                    }
                    def remote = null
                    for (r in VISITED) { if (r.name == watcher.host) { remote = r } }
                    if (!remote) {
                        error("${watcher.host} was not reached in this run, so there is nowhere to publish")
                    }

                    sshPut remote: remote, from: 'drift.json', into: "${REMOTE_DIR}/"
                    // Into the container rather than onto the bind mount: /data
                    // belongs to the runtime's uid and the SSH login is not it, so a
                    // plain copy would need sudo. `docker cp` writes as root inside,
                    // the mode comes across, and the flow reads it as any other file.
                    sshCommand remote: remote, command: """
                        set -e
                        chmod 644 ${REMOTE_DIR}/drift.json
                        docker exec -u 0 ${watcher.compose_service} mkdir -p /data/drift
                        docker cp ${REMOTE_DIR}/drift.json ${watcher.compose_service}:/data/drift/drift.json
                    """
                    echo "drift.json is at /data/drift/drift.json in ${watcher.name}"
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'drift.json, public/index.html', allowEmptyArchive: true
            script {
                sh 'rm -f registry.json sweep.env || true'
                for (remote in VISITED) {
                    sshCommand remote: remote, failOnError: false,
                               command: "rm -rf ${REMOTE_DIR}"
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------

void sweepHost(Map hostConfig, String host, List list) {
    if (!hostConfig) {
        error("host '${host}' is not in the Jenkins host map")
    }

    // Every instance on this host in one binding, so the sweep is one SSH
    // session per host rather than one per instance. The variables are named
    // after the credential id, which is also the stem deploy.py reads on the
    // other side — so the env file can be written by the shell from its own
    // environment, and no password is ever assigned to a Groovy variable.
    def bindings = [usernamePassword(credentialsId: hostConfig.credId,
                                     usernameVariable: 'REMOTE_USR', passwordVariable: 'REMOTE_PSW')]
    for (inst in list) {
        def stem = inst.auth_credential_id.replaceAll(/[^A-Za-z0-9]/, '_').toUpperCase()
        bindings << usernamePassword(credentialsId: inst.auth_credential_id,
                                     usernameVariable: "${stem}_USR",
                                     passwordVariable: "${stem}_PSW")
    }

    withCredentials(bindings) {
        def remote = [
            name: host, host: hostConfig.host, port: hostConfig.port,
            allowAnyHosts: hostConfig.allowAnyHosts,
            user: REMOTE_USR, password: REMOTE_PSW,
        ]
        if (!VISITED.any { it.host == remote.host }) { VISITED << remote }

        // The env file is written BY the shell, from the variables withCredentials
        // put in its environment — the values never pass through Groovy, so they
        // cannot end up in a stack trace or a serialized pipeline state. It is
        // sourced and deleted on the far side in one shell, so no password rests
        // on the host between steps either.
        def lines = ['set +x', 'umask 077', ': > sweep.env']
        for (inst in list) {
            def stem = inst.auth_credential_id.replaceAll(/[^A-Za-z0-9]/, '_').toUpperCase()
            lines << "echo \"export ${stem}_USR='\$${stem}_USR'\" >> sweep.env"
            lines << "echo \"export ${stem}_PSW='\$${stem}_PSW'\" >> sweep.env"
        }
        sh lines.join('\n')

        sshCommand remote: remote, command: "mkdir -p ${REMOTE_DIR}/scripts " +
                   list.collect { "${REMOTE_DIR}/apps/${it.app}" }.join(' ')
        sshPut remote: remote, from: 'scripts/drift-check.py', into: "${REMOTE_DIR}/scripts/"
        sshPut remote: remote, from: 'scripts/nodered.py',     into: "${REMOTE_DIR}/scripts/"
        sshPut remote: remote, from: 'scripts/normalize.py',   into: "${REMOTE_DIR}/scripts/"
        sshPut remote: remote, from: 'registry.json',          into: "${REMOTE_DIR}/"
        sshPut remote: remote, from: 'sweep.env',              into: "${REMOTE_DIR}/"
        for (inst in list) {
            sshPut remote: remote, from: "apps/${inst.app}/flows.json",
                   into: "${REMOTE_DIR}/apps/${inst.app}/"
        }

        // --fail-on-drift is deliberately absent: drift is what this job exists
        // to report, and a red build for it would teach everyone to ignore the
        // colour. Exit 1 (something unreachable) is tolerated the same way — the
        // row says so, and the page shows it.
        sshCommand remote: remote, failOnError: false, command: """
            set -e
            cd ${REMOTE_DIR}
            chmod 600 sweep.env
            set +x
            . ./sweep.env
            rm -f sweep.env
            python3 scripts/drift-check.py --host ${host} --json drift-${host}.json || true
        """
        sshGet remote: remote, from: "${REMOTE_DIR}/drift-${host}.json",
               into: "drift-${host}.json", override: true

        def rows = readJSON file: "drift-${host}.json"
        RESULTS.addAll(rows)
        echo "${host}: ${rows.size()} instances read"
    }
}
