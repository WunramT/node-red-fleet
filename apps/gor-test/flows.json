  {
    "id": "407f8120d8dc0f41",
    "type": "function",
    "z": "6d021e54d551838e",
    "name": "set errorFlag & change delay",
    "finalize": "",
    "func": "const errorFlag = flow.get(\"errorFlag\") || false;\nif (!errorFlag) {\n    flow.set(\"errorFlag\", true)\n};\nmsg.delay = 10000;  // 10 seconds between retry\nreturn msg;",
    "initialize": "",
    "libs": [],
    "noerr": 0,
    "outputs": 1,
    "timeout": 0,
    "x": 540,
    "y": 200,
    "wires": [
      [
        "cc658a1ad82b89fa"
      ]
    ]
  },
  {
    "id": "4b3174349dfa902d",
    "type": "function",
    "z": "6d021e54d551838e",
    "name": "reset trigger",
    "finalize": "",
    "func": "// Reset the trigger and set the delay to high value to avoid\n// peeking the same message from the queue again,\n// if the database is not responding within a few seconds\n\nmsg.reset = true;\nreturn msg;",
    "initialize": "",
    "libs": [],
    "noerr": 0,
    "outputs": 1,
    "timeout": 0,
    "x": 450,
    "y": 140,
    "wires": [
      [
        "cc658a1ad82b89fa"
      ]
    ]
  },
  {
    "id": "54350b07859780cf",
    "type": "function",
    "z": "6d021e54d551838e",
    "name": "Set queueText",
    "finalize": "",
    "func": "// Set the queue text to use it in another node status\nflow.set(\"queueText\", msg.status.text)",
    "initialize": "",
    "libs": [],
    "noerr": 0,
    "outputs": 1,
    "timeout": 0,
    "x": 520,
    "y": 520,
    "wires": [
      []
    ]
  },
  {
    "id": "5a8106c4581260c2",
    "type": "function",
    "z": "6d021e54d551838e",
    "name": "peek",
    "finalize": "",
    "func": "// get errorFlag\nconst errorFlag = flow.get('errorFlag') || false;\n\n// if errorFlag is True, do nothing and set errorFlag to false\nif (errorFlag) {\n    flow.set('errorFlag', false)\n    return null\n} else {\n    msg.topic = 'control'\n    msg.payload = 'peek'\n    return msg\n}",
    "initialize": "",
    "libs": [],
    "noerr": 0,
    "outputs": 1,
    "timeout": "",
    "x": 990,
    "y": 200,
    "wires": [
      [
        "9f493bfba8c87738"
      ]
    ]
  },
  {
    "id": "7a8bd8147ad13466",
    "type": "comment",
