  },
  {
    "id": "8099e938eed20130",
    "type": "function",
    "z": "6d021e54d551838e",
    "name": "drop message & reactivate trigger",
    "finalize": "",
    "func": "// Delete the oldest message on success\n// Send a delay message to the trigger which will change the delay settings and restart the trigger\nnode.send([\n    {topic: \"control\", payload: \"drop\"},  // Output 1\n    {delay: 1000} // Output 2\n]);",
    "initialize": "// Der Code hier wird ausgeführt,\n// wenn der Node gestartet wird\n\n// Set a initial state to see if a message has reached this node.\nconst errorFlag = flow.get(\"errorFlag\") || false;",
    "libs": [],
    "noerr": 0,
    "outputs": 2,
    "timeout": "",
    "x": 700,
    "y": 100,
    "wires": [
      [
        "9f493bfba8c87738"
      ],
      [
        "cc658a1ad82b89fa"
      ]
    ]
  },
  {
    "id": "81a4178fc3418e96",
    "type": "function",
    "z": "6d021e54d551838e",
    "name": "SQL Error Status Message",
    "finalize": "",
    "func": "// Combine the error message and the queueText\n\nconst errorMessage = msg.error.message;\nconst queueText = flow.get(\"queueText\") || \"Queue: 0\";\nconst combinedMessage = `${queueText} - ${errorMessage}`\nnode.status({ fill: \"red\", shape: \"ring\", text: combinedMessage});",
    "initialize": "",
    "libs": [],
    "noerr": 0,
    "outputs": 1,
    "timeout": 0,
    "x": 500,
    "y": 320,
    "wires": [
      []
    ]
  },
