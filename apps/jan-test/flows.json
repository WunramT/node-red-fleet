  {
    "id": "set-base",
    "type": "function",
    "z": "e5ba4c7168d9505b",
    "name": "Init & Config-Queue",
    "finalize": "",
    "func": "// Statische Basisdaten\nflow.set('BASE_URL', 'http://dpn-svr-dl:5000');\nflow.set('USERNAME', 'wunram');\nflow.set('PASSWORD', 'iBhYkE67CG!D');\n// Reset State\nflow.set('RUN_INDEX', 0);\nflow.set('RETRY_MAP', {});\nflow.set('COOKIES', {});\n// Gemeinsame Standardparameter\nconst common = { test_size: 0.2, cv_folds: 5, top_n_features: 80, enable_tracking: false, use_transfer_learning: false };\n// Sechs Läufe: je Modelltyp mit/ohne GridSearch\nconst queue = [\n { name: 'lgbm_no_gs', description: 'LightGBM ohne GridSearch', parameters: { ...common, model_type: 'lightgbm', use_gridsearch: false, n_estimators: 100, max_depth: 5, learning_rate: 0.1 } },\n { name: 'lgbm_gs', description: 'LightGBM mit GridSearch', parameters: { ...common, model_type: 'lightgbm', use_gridsearch: true, n_estimators: 100, max_depth: 5, learning_rate: 0.1 } },\n { name: 'xgb_no_gs', description: 'XGBoost ohne GridSearch', parameters: { ...common, model_type: 'xgboost', use_gridsearch: false, n_estimators: 300, max_depth: 30, learning_rate: 0.1 } },\n { name: 'xgb_gs', description: 'XGBoost mit GridSearch', parameters: { ...common, model_type: 'xgboost', use_gridsearch: true, n_estimators: 300, max_depth: 30, learning_rate: 0.1 } },\n { name: 'rf_no_gs', description: 'RandomForest ohne GS', parameters: { ...common, model_type: 'random_forest', use_gridsearch: false, n_estimators: 300, max_depth: 30 } },\n { name: 'rf_gs', description: 'RandomForest mit GS', parameters: { ...common, model_type: 'random_forest', use_gridsearch: true, n_estimators: 300, max_depth: 30 } }\n];\nflow.set('CONFIG_QUEUE', queue);\n// Weiter zu Auth-Status\nreturn msg;",
    "initialize": "",
    "libs": [],
    "noerr": 0,
    "outputs": 1,
    "timeout": "",
    "x": 490,
    "y": 260,
