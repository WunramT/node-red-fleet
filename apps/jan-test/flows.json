  {
    "id": "handle-failed",
    "type": "function",
    "z": "e5ba4c7168d9505b",
    "name": "Retry bis 3",
    "func": "const idx = (flow.get('RUN_INDEX')||1) - 1; // aktuell gelaufener Index\nlet retryMap = flow.get('RETRY_MAP') || {};\nconst key = 'run_' + idx;\nconst count = retryMap[key] || 0;\nif (count < 3) {\n retryMap[key] = count + 1;\n flow.set('RETRY_MAP', retryMap);\n // RUN_INDEX zurücksetzen, um dieselbe Config zu wiederholen\n flow.set('RUN_INDEX', idx);\n return msg;\n} else {\n // Retry-Zähler zurücksetzen und weiter zur nächsten Config\n retryMap[key] = 0;\n flow.set('RETRY_MAP', retryMap);\n return { payload: 'skip' };\n}",
    "outputs": 1,
